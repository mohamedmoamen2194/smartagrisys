# Use hard links instead of symlinks on Windows to avoid permission issues
symlink=false
shamefully-hoist=true

# Hoist all Prisma packages to root for better module resolution
public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=*@prisma/*
public-hoist-pattern[]=*@swc/*

# Allow build scripts for packages that need them (Prisma, Next.js, etc.)
enable-pre-post-scripts=true
ignore-scripts=false

# Disable script approval requirement (for development only)
# WARNING: Only use this in trusted projects
scripts-prepend-node-path=true

