# Environment variables for SmartAgriSys MCB

# LLM Provider Configuration
# Choose one: openai, groq, anthropic
LLM_PROVIDER=groq

# API Keys (only one needed based on provider)
# Place your key in a local .env file, never commit real secrets
GROQ_API_KEY=

# MCB Configuration
MCB_USE_LLM=true
MCB_FALLBACK_TO_RULES=true
MCB_DYNAMIC_EXTRACTION=true
MCB_DYNAMIC_TREATMENTS=true

# Model Configuration
CROP_MODEL_PATH=./smart_agri_models/crop_rec/crop_recommendation_rf_model (1).joblib
DISEASE_MODEL_PATH=./smart_agri_models/disease_detection/mobilenet_plant_weights.pt
