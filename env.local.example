# SmartAgriSys Environment Configuration
# Copy this file to .env.local and update the values

# ============================================================================
# MCB Backend Configuration (NEW - for AI model integration)
# ============================================================================
# MCB Backend URL (where your Python MCB server is running)
MCB_BACKEND_URL=http://localhost:8001

# For production deployment (Vercel), use your deployed MCB URL:
# MCB_BACKEND_URL=https://your-mcb-backend.vercel.app

# ============================================================================
# Database Configuration (EXISTING - keep your current values)
# ============================================================================
# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://user:pass@localhost:5432/smartagrisys
DATABASE_URL= postgresql://neondb_owner:npg_YADpEJ9zXwu1@ep-autumn-block-a5t61nrr-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ============================================================================
# Authentication Configuration (if using NextAuth.js)
# ============================================================================
# NEXTAUTH_SECRET: A random string used to encrypt JWT tokens and sessions
# Generate one at: https://generate-secret.vercel.app/32
# Or run: openssl rand -base64 32
NEXTAUTH_SECRET= 4bbd8e3b249e427ff048157463340da2

# NEXTAUTH_URL: Your app's URL (for OAuth callbacks)
NEXTAUTH_URL="http://localhost:3000"

# ============================================================================
# OAuth Providers (if using social login)
# ============================================================================
# Google OAuth (optional)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (optional)  
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# ============================================================================
# Other Configuration
# ============================================================================
# Node environment
NODE_ENV="development"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
