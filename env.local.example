# SmartAgriSys Environment Configuration
# Copy this file to .env.local and update the values

# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================
# PostgreSQL database connection string
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# ============================================================================
# Authentication Configuration (REQUIRED)
# ============================================================================
# NextAuth secret for JWT encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# AI Backend Configuration
# ============================================================================
# AI Backend URL (Modal deployment URL or local)
# For Modal: https://your-username--smart-agri-models-fastapi-app.modal.run
# For local: http://localhost:8000
AI_BACKEND_URL=http://localhost:8000

# ============================================================================
# LLM Configuration (for Python backend - set in Modal secrets)
# ============================================================================
# These are set in Modal secrets, not here for production
# OPENROUTER_API_KEY - Set in Modal dashboard
# OPENROUTER_BASE_URL - Set in Modal dashboard (optional)
# LLM_MODEL - Set in Modal dashboard (optional)
